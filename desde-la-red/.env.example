# Copia este archivo a .env.local y pon los valores de tu proyecto de Supabase
# (Project Settings → API). La clave "anon" es pública: va en la app y está
# protegida por las políticas de seguridad de la base de datos.
#
# Sin estas variables la app arranca en modo demo local, sin cuentas.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
