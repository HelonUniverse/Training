# Public - safe in the browser bundle. RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Optional: absolute origin used to build auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never import outside the
# entry points listed in docs/architecture/12-service-role-boundary.md.
# Not used anywhere in STEP 3.
# SUPABASE_SERVICE_ROLE_KEY=<service role key>
